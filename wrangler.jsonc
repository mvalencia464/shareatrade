{
  "name": "shareatrade",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/go/*", "/*/*", "!/_astro/*"]
  }
}

{
  "name": "shareatrade",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:backend": "convex dev",
    "build": "astro build && node scripts/write-cloudflare-redirects.mjs",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "import:contractors": "node scripts/import-contractors.mjs",
    "import:contractors:dry": "node scripts/import-contractors.mjs --dry-run",
    "import:directory": "node scripts/import-directory.mjs",
    "import:directory:dry": "node scripts/import-directory.mjs --dry-run",
    "import:nicc": "node scripts/import-nicc.mjs",
    "import:nicc:dry": "node scripts/import-nicc.mjs --dry-run",
    "enrich:licenses": "node scripts/enrich-licenses.mjs",
    "enrich:licenses:dry": "node scripts/enrich-licenses.mjs --dry-run",
    "gbp:refresh:post": "node scripts/gbp-refresh.mjs --post",
    "gbp:refresh:post:dry": "node scripts/gbp-refresh.mjs --post --dry-run",
    "gbp:refresh:collect": "node scripts/gbp-refresh.mjs --collect",
    "gbp:refresh:collect:dry": "node scripts/gbp-refresh.mjs --collect --dry-run",
    "import:localprospects": "node scripts/import-localprospects.mjs",
    "import:localprospects:dry": "node scripts/import-localprospects.mjs --dry-run",
    "search:localprospects": "node scripts/search-localprospects.mjs",
    "search:localprospects:dry": "node scripts/search-localprospects.mjs --dry-run",
    "export:lp-directory": "node scripts/export-lp-directory.mjs",
    "export:highlevel": "node scripts/export-highlevel.mjs",
    "export:highlevel:dry": "node scripts/export-highlevel.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.0",
    "convex": "^1.43.0",
    "csv-parse": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}

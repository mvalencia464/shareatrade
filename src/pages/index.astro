---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, directoryPath } from "../lib/site";
import { liveMarkets } from "../lib/markets";

export const prerender = true;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{SITE_NAME} | Find a trade. Share a name.</title>
    <meta
      name="description"
      content="A free contractor directory you can paste into a neighborhood chat. Pick a market to browse trades by city and rating."
    />
  </Fragment>

  <section class="hero market-home">
    <p class="hero-eyebrow">Choose a market</p>
    <h1>Find a recommended trade. Share their name in one click.</h1>
    <p class="hero-why">
      No accounts. No sign-ups. Start with a city, then paste a complete listing
      into a group thread.
    </p>
    <ul class="market-grid">
      {liveMarkets().map((market) => (
        <li>
          <a class="market-card" href={directoryPath(market.slug)}>
            <span class="market-card-name">{market.name}</span>
            <span class="market-card-meta">
              {market.state} · {market.tagline}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

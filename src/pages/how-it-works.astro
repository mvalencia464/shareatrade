---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ShareExampleSheet } from "../components/ShareExampleSheet";
---

<BaseLayout>
  <Fragment slot="head">
    <title>How it works | Spokane Contractors</title>
    <meta
      name="description"
      content="Free Spokane contractor directory—no account. Filter, call, save favorites on this device."
    />
  </Fragment>

  <article class="how-it-works">
    <h1>How it works</h1>
    <p class="lede">
      Free directory. No account. Find a trade, open a profile, call or email from
      the listing.
    </p>

    <section>
      <h2>Find someone</h2>
      <ol>
        <li>Filter by trade, city, or rating—or search by name.</li>
        <li>Open a profile for contact info and license details when we have them.</li>
        <li>Tap to call, email, or visit their site.</li>
      </ol>
    </section>

    <section>
      <h2>Share a listing</h2>
      <p>
        Tap the share icon on a card or profile. On a phone, the system share
        sheet opens so you can send it in Messages, Mail, or another app. If
        share isn’t available, we copy the same details to your clipboard.
      </p>
      <p>Copied text looks like this:</p>
      <ShareExampleSheet />
    </section>

    <section>
      <h2>Saved list</h2>
      <p>
        Heart a listing to save it. Check <a href="/?view=saved">Saved</a> anytime.
        Saves stay on this browser only—they don’t sync across phones or computers,
        and clearing site data wipes them.
      </p>
    </section>

    <section>
      <h2>Before you hire</h2>
      <p>
        Double-check licensing, insurance, and scope with the contractor yourself.
      </p>
    </section>

    <section>
      <h2>Contractors</h2>
      <p>
        We pull from Google Business Profile. Keep yours current, then
        <a href="/get-listed">request a listing</a> (or flag a fix).
      </p>
    </section>

    <p class="how-actions">
      <a class="button button-primary" href="/">Browse contractors</a>
      <a class="button button-secondary" href="/get-listed">Get listed</a>
    </p>
  </article>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ShareGroupMockup } from "../components/ShareGroupMockup";
---

<BaseLayout>
  <Fragment slot="head">
    <title>How it works | Spokane Contractors</title>
    <meta
      name="description"
      content="One tap, no sign-up. Find a Spokane-area contractor and share a complete name in a neighborhood chat."
    />
  </Fragment>

  <article class="how-it-works">
    <h1>How it works</h1>
    <p class="lede">
      One tap. No sign-up. Find a trade, open a listing, call—or share a complete
      name in a neighborhood chat.{" "}
      <a href="/why">Why this exists</a>.
    </p>

    <section>
      <h2>Find someone</h2>
      <ol>
        <li>Filter by trade, city, or rating—or search by name.</li>
        <li>Open a profile for contact info and license details when we have them.</li>
        <li>Tap to call, email, or visit their site.</li>
      </ol>
    </section>

    <section>
      <h2>Share in one tap</h2>
      <p>
        Tap share on a card or profile. On a phone, your share sheet opens. If it
        doesn’t, we copy the same note. No account. The paste is the name, rating,
        phone, site, and listing link—ready for a group thread.
      </p>
      <ShareGroupMockup origin="https://spokanelist.com" />
    </section>

    <section>
      <h2>Saved list</h2>
      <p>
        Heart a listing to keep it. Open <a href="/?view=saved">Saved</a> anytime.
        Saves stay on this browser only.
      </p>
    </section>

    <section>
      <h2>Before you hire</h2>
      <p>
        Verify licensing, insurance, and scope yourself. Short questions and
        official links are on <a href="/hiring-help">hiring help</a>—not legal
        advice.
      </p>
    </section>

    <section>
      <h2>Contractors</h2>
      <p>
        Listings come from Google Business Profile. Keep yours current, then{" "}
        <a href="/get-listed">request a listing</a>. Free. More on{" "}
        <a href="/for-contractors">resources for contractors</a>.
      </p>
    </section>

    <p class="how-actions">
      <a class="button button-primary" href="/">Browse contractors</a>
      <a class="button button-secondary" href="/get-listed">Get listed</a>
    </p>
  </article>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ContractorDetailApp } from "../../components/ContractorDetailApp";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";
import { isMarketSlug } from "../../lib/markets";
import { SITE_NAME } from "../../lib/site";

export const prerender = false;

const marketSlug = Astro.params.market ?? "";
const slug = Astro.params.slug ?? "";
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL ?? "";

let name = "Contractor";
let category = "Contractor";
let city: string | undefined;
let found = false;

if (convexUrl && slug && isMarketSlug(marketSlug)) {
  const client = new ConvexHttpClient(convexUrl);
  const contractor = await client.query(api.contractors.getByMarketAndSlug, {
    marketSlug,
    slug,
  });
  if (contractor) {
    found = true;
    name = contractor.name;
    category = contractor.category;
    city = contractor.city;
    Astro.response.headers.set(
      "Cache-Control",
      "public, s-maxage=3600, stale-while-revalidate=86400",
    );
  } else {
    Astro.response.status = 404;
  }
} else {
  Astro.response.status = 404;
}

const title = name;
const description = `${category}${city ? ` in ${city}` : ""} — ${SITE_NAME} directory.`;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
  </Fragment>
  {
    found ? (
      <ContractorDetailApp
        client:load
        convexUrl={convexUrl}
        marketSlug={marketSlug}
        slug={slug}
      />
    ) : (
      <p class="env-warning">This listing was not found.</p>
    )
  }
</BaseLayout>

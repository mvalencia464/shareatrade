---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DirectoryApp } from "../../components/DirectoryApp";
import { getMarket } from "../../lib/markets";
import { SITE_NAME } from "../../lib/site";

export const prerender = false;

const marketSlug = Astro.params.market ?? "";
const market = getMarket(marketSlug);
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL ?? "";

if (!market) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=3600, stale-while-revalidate=86400",
  );
}
---

<BaseLayout>
  <Fragment slot="head">
    <title>
      {market ? `${market.name} contractors` : "Contractors"} | {SITE_NAME}
    </title>
    <meta
      name="description"
      content={
        market
          ? `Find ${market.name}-area contractors by trade, city, and rating.`
          : "Find local contractors by trade, city, and rating."
      }
    />
  </Fragment>
  {
    convexUrl && market ? (
      <DirectoryApp client:load convexUrl={convexUrl} marketSlug={market.slug} />
    ) : market ? (
      <p class="env-warning">
        Set PUBLIC_CONVEX_URL in .env.local after running npx convex dev.
      </p>
    ) : (
      <p class="env-warning">This market was not found.</p>
    )
  }
</BaseLayout>

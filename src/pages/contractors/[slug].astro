---
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";
import { DEFAULT_MARKET_SLUG } from "../../lib/markets";
import { listingPath } from "../../lib/site";

export async function getStaticPaths() {
  const convexUrl = import.meta.env.PUBLIC_CONVEX_URL;
  if (!convexUrl) {
    return [];
  }
  const client = new ConvexHttpClient(convexUrl);
  const contractors = await client.query(api.contractors.listByMarket, {
    marketSlug: DEFAULT_MARKET_SLUG,
  });
  return contractors.map((contractor) => ({
    params: { slug: contractor.slug },
  }));
}

const slug = Astro.params.slug;
if (slug) {
  return Astro.redirect(listingPath(DEFAULT_MARKET_SLUG, slug), 301);
}
---

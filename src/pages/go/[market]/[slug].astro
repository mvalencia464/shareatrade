---
import CompanySiteLayout from "../../../layouts/CompanySiteLayout.astro";
import CompanySiteReviews from "../../../components/CompanySiteReviews.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";
import {
  formatReviewCount,
  serviceAreaChips,
  siteChannels,
  siteCustomValues,
  type SiteCustomValues,
} from "../../../lib/siteCustomValues";
import {
  DEMO_CREW_PHOTO,
  DEMO_PROJECTS,
  DEMO_REVIEWS,
  DEMO_TEAM,
  demoAbout,
  nicheHeroPhoto,
} from "../../../lib/companySiteDemo";
import { MARKETS, getMarket, isMarketSlug } from "../../../lib/markets";
import { uniqueBySlug } from "../../../lib/site";
import CompanySiteStars from "../../../components/CompanySiteStars.astro";
import { CompanySiteChannels } from "../../../components/CompanySiteChannels";
import { CompanySiteCallCta } from "../../../components/CompanySiteCallCta";

export async function getStaticPaths() {
  const convexUrl = import.meta.env.PUBLIC_CONVEX_URL;
  if (!convexUrl) {
    return [];
  }
  const client = new ConvexHttpClient(convexUrl);
  const paths: Array<{ params: { market: string; slug: string } }> = [];
  for (const market of MARKETS) {
    const contractors = uniqueBySlug(
      await client.query(api.contractors.listByMarket, {
        marketSlug: market.slug,
      }),
    );
    for (const contractor of contractors) {
      paths.push({
        params: { market: market.slug, slug: contractor.slug },
      });
    }
  }
  return paths;
}

const marketSlug = Astro.params.market ?? "";
const { slug } = Astro.params;
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL;

let values: SiteCustomValues | null = null;
if (convexUrl && slug && isMarketSlug(marketSlug)) {
  const client = new ConvexHttpClient(convexUrl);
  const contractor = await client.query(api.contractors.getByMarketAndSlug, {
    marketSlug,
    slug,
  });
  if (contractor) {
    values = siteCustomValues(contractor);
  }
}

const title = values ? values.business_name : "Company";
const description = values
  ? `${values.niche} serving ${values.service_area}`
  : "";

const initial = values?.business_name.trim().charAt(0).toUpperCase() || "?";
const reviewsLabel =
  values?.reviews != null
    ? `${formatReviewCount(values.reviews)} Google review${values.reviews === 1 ? "" : "s"}`
    : undefined;
const about = values ? demoAbout(values) : null;
const cityLabel = values?.city ?? getMarket(marketSlug)?.name ?? "this area";
const coverSrc = values?.cover_url || (values ? nicheHeroPhoto(values.niche) : DEMO_PROJECTS[0]?.src);
const areaChips = values ? serviceAreaChips(values.city, marketSlug) : [];
const channels = values ? siteChannels(values) : [];
const previewReviews = DEMO_REVIEWS.slice(0, 3);
const extraReviews = DEMO_REVIEWS.slice(3);
---

<CompanySiteLayout title={title} description={description}>
  {
    values ? (
      <>
        <div class="cs-cover">
          {coverSrc ? <img src={coverSrc} alt="" /> : null}
        </div>
        <div class="cs-identity">
          {values.logo_url ? (
            <img class="cs-logo" src={values.logo_url} alt="" />
          ) : (
            <div class="cs-logo cs-logo-fallback" aria-hidden="true">
              {initial}
            </div>
          )}
          <h1 class="cs-name">{values.business_name}</h1>
        </div>
        <main class="cs-main">
          <div class="cs-meta">
            {values.niche ? <span class="cs-chip">{values.niche}</span> : null}
            {areaChips.map((chip) => (
              <span class="cs-chip cs-chip-area">{chip}</span>
            ))}
          </div>

          <CompanySiteChannels client:load channels={channels} />

          {values.rating != null || values.reviews != null ? (
            <CompanySiteReviews
              rating={values.rating}
              reviewsLabel={reviewsLabel}
              href={values.gbp_url}
            />
          ) : null}

          {values.license_number ? (
            <div class="cs-card">
              <p class="cs-kicker">License</p>
              <p>
                {values.license_type ? `${values.license_type} · ` : ""}
                {values.license_number}
                {values.license_status ? ` · ${values.license_status}` : ""}
              </p>
            </div>
          ) : null}

          {values.address ? (
            <div class="cs-card">
              <p class="cs-kicker">Address</p>
              <p>{values.address}</p>
            </div>
          ) : null}

          <p class="cs-proof">{values.proof_line}</p>

          {about ? (
            <section class="cs-section" aria-labelledby="cs-about-title">
              <p class="cs-kicker">{about.kicker}</p>
              <h2 id="cs-about-title" class="cs-h2">
                A small local company — not a marketing machine
              </h2>
              <p class="cs-demo-flag">AI sample photo for this trade — not this company</p>
              <img class="cs-about-photo" src={about.photo} alt="" />
              <blockquote class="cs-quote">“{about.quote}”</blockquote>
              <div class="cs-owner">
                <strong>{about.owner}</strong>
                <span>{about.ownerTitle}</span>
              </div>
              <p class="cs-copy">{about.intro}</p>
              <p class="cs-copy">{about.body}</p>
              <div class="cs-actions">
                {values.phone_tel ? (
                  <CompanySiteCallCta
                    client:load
                    variant="inline"
                    href={values.phone_tel}
                    label={about.callCta}
                    phone={values.phone}
                  />
                ) : null}
                <a class="cs-inline-cta cs-inline-cta-ghost" href="#cs-quote">
                  Get a quote instead
                </a>
              </div>
            </section>
          ) : null}

          {about?.services?.length ? (
            <section class="cs-section" aria-labelledby="cs-services-title">
              <p class="cs-kicker">Sample services</p>
              <h2 id="cs-services-title" class="cs-h2">
                What this kind of {values.niche.toLowerCase()} usually offers
              </h2>
              <p class="cs-demo-flag">Example menu for this trade — not a live catalog</p>
              <div class="cs-services">
                {about.services.map((service) => (
                  <article class="cs-service">
                    <p class="cs-service-name">{service.name}</p>
                    <p class="cs-service-blurb">{service.blurb}</p>
                  </article>
                ))}
              </div>
            </section>
          ) : null}

          <section class="cs-section" id="cs-quote" aria-labelledby="cs-quote-title">
            <p class="cs-kicker">Free quote</p>
            <h2 id="cs-quote-title" class="cs-h2">
              Tell us what you need in {cityLabel}
            </h2>
            <p class="cs-copy">
              Preview only — this form does not send. Call if you want to reach them.
            </p>
            <form class="cs-form" id="cs-quote-form" action="#" method="post" novalidate>
              <label class="cs-field">
                <span>Name</span>
                <input type="text" name="name" autocomplete="name" placeholder="Your name" />
              </label>
              <label class="cs-field">
                <span>Phone</span>
                <input type="tel" name="phone" autocomplete="tel" placeholder="(509) 555-0123" />
              </label>
              <label class="cs-field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="email" placeholder="you@email.com" />
              </label>
              <label class="cs-field">
                <span>Address or neighborhood</span>
                <input
                  type="text"
                  name="location"
                  autocomplete="street-address"
                  placeholder={cityLabel}
                />
              </label>
              <label class="cs-field">
                <span>What do you need?</span>
                <textarea
                  name="details"
                  rows="4"
                  placeholder={about?.formPrompt}
                ></textarea>
              </label>
              <button class="cs-form-submit" type="submit">
                {about?.formCta ?? "Get my free quote"}
              </button>
              <p class="cs-form-note">Nothing is sent from this preview.</p>
            </form>
            <p class="cs-form-thanks" id="cs-quote-thanks" hidden>
              Still a preview — nothing was sent. Use Call if you want the real listing.
            </p>
          </section>

          <section class="cs-section" aria-labelledby="cs-work-title">
            <p class="cs-kicker">Sample photos</p>
            <h2 id="cs-work-title" class="cs-h2">
              Layout example — not this company’s jobs
            </h2>
            <p class="cs-demo-flag">Roofing photos from a demo gallery</p>
            <div class="cs-projects">
              {DEMO_PROJECTS.map((project) => (
                <figure class="cs-project">
                  <img src={project.src} alt="" />
                  <figcaption>
                    <span>{project.place}</span>
                    {project.label}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>

          <section class="cs-section" aria-labelledby="cs-crew-title">
            <p class="cs-kicker">Sample crew</p>
            <h2 id="cs-crew-title" class="cs-h2">
              {about?.crewLine ?? `Meet the folks who show up in ${cityLabel}`}
            </h2>
            <p class="cs-demo-flag">Placeholder photos — The Summit Squad</p>
            <img class="cs-crew-photo" src={DEMO_CREW_PHOTO} alt="" />
            <div class="cs-team">
              {DEMO_TEAM.map((member) => (
                <article class="cs-team-card">
                  <img src={member.photo} alt="" />
                  <div>
                    <p class="cs-team-name">{member.name}</p>
                    <p class="cs-team-role">{member.role}</p>
                    <p class="cs-team-blurb">{member.blurb}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="cs-section" aria-labelledby="cs-reviews-title">
            <p class="cs-kicker">Sample reviews</p>
            <h2 id="cs-reviews-title" class="cs-h2">
              How review cards could look
            </h2>
            <p class="cs-demo-flag">
              Made-up quotes for layout — real Google count is above
            </p>
            <div class="cs-review-list">
              {previewReviews.map((review) => (
                <article class="cs-review-card">
                  <header class="cs-review-head">
                    <img class="cs-avatar" src={review.avatar} alt="" />
                    <div class="cs-review-meta">
                      <strong>{review.name}</strong>
                      <span>
                        {review.city} · {review.date}
                      </span>
                    </div>
                    <CompanySiteStars rating={review.rating} />
                  </header>
                  <p>{review.text}</p>
                </article>
              ))}
            </div>
            {extraReviews.length > 0 ? (
              <details class="cs-more-reviews">
                <summary>
                  See {extraReviews.length} more sample reviews
                </summary>
                <div class="cs-review-list">
                  {extraReviews.map((review) => (
                    <article class="cs-review-card">
                      <header class="cs-review-head">
                        <img class="cs-avatar" src={review.avatar} alt="" />
                        <div class="cs-review-meta">
                          <strong>{review.name}</strong>
                          <span>
                            {review.city} · {review.date}
                          </span>
                        </div>
                        <CompanySiteStars rating={review.rating} />
                      </header>
                      <p>{review.text}</p>
                    </article>
                  ))}
                </div>
              </details>
            ) : null}
          </section>

          {values.website ? (
            <a class="cs-link" href={values.website} rel="nofollow noopener noreferrer">
              Visit website
            </a>
          ) : null}

          <p class="cs-powered">
            <a href="/">share<span class="brand-a">a</span>trade</a>
          </p>
        </main>
          {values.phone_tel && values.phone ? (
            <CompanySiteCallCta
              client:load
              variant="bar"
              href={values.phone_tel}
              label="Call"
              phone={values.phone}
            />
          ) : null}
      </>
    ) : (
      <p class="cs-missing">This company page is not available.</p>
    )
  }
</CompanySiteLayout>

<script>
  const form = document.getElementById("cs-quote-form");
  const thanks = document.getElementById("cs-quote-thanks");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    thanks?.removeAttribute("hidden");
  });
</script>

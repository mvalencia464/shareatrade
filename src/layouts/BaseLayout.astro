---
import "../styles/global.css";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSaved = path === "/" && Astro.url.searchParams.get("view") === "saved";
const isDirectory = path === "/" && !isSaved;

function current(hrefPath: string, saved = false) {
  if (saved) return isSaved ? "page" : undefined;
  if (hrefPath === "/") return isDirectory ? "page" : undefined;
  return path === hrefPath ? "page" : undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=Caveat:wght@600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, noai, noimageai" />
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <p class="no-signup-sticker">
        <span class="no-signup-sticker-copy">No accounts. No sign-ups.</span>
      </p>
      <header class="site-header">
        <div class="brand-block">
          <a class="brand" href="/">
            <img class="brand-logo" src="/logo.svg" alt="" width="42" height="56" />
            <span class="brand-text">
              <span class="brand-name">Spokane Contractors</span>
              <span class="brand-tag">Find a trade. Share a name.</span>
            </span>
          </a>
        </div>
        <details class="nav-drawer">
          <summary class="nav-hamburger" aria-label="Menu">
            <span class="nav-hamburger-bars" aria-hidden="true"></span>
          </summary>
          <nav class="site-nav" aria-label="Primary">
            <details class="nav-menu">
              <summary>Homeowners</summary>
              <div class="nav-panel">
                <a href="/" aria-current={current("/")}>
                  <span class="nav-link-title">Directory</span>
                  <span class="nav-link-sub">Browse by trade, city, and rating</span>
                </a>
                <a href="/?view=saved" aria-current={current("/", true)}>
                  <span class="nav-link-title">Saved</span>
                  <span class="nav-link-sub">Names you’ve kept on this device</span>
                </a>
                <a href="/how-it-works" aria-current={current("/how-it-works")}>
                  <span class="nav-link-title">How it works</span>
                  <span class="nav-link-sub">Find, save, and share a listing</span>
                </a>
                <a href="/hiring-help" aria-current={current("/hiring-help")}>
                  <span class="nav-link-title">Hiring help</span>
                  <span class="nav-link-sub">What to ask before you hire</span>
                </a>
                <a href="/why" aria-current={current("/why")}>
                  <span class="nav-link-title">Why this exists</span>
                  <span class="nav-link-sub">Why neighbors share names here</span>
                </a>
              </div>
            </details>
            <details class="nav-menu">
              <summary>Contractors</summary>
              <div class="nav-panel">
                <a href="/get-listed" aria-current={current("/get-listed")}>
                  <span class="nav-link-title">Get listed</span>
                  <span class="nav-link-sub">Request a free directory listing</span>
                </a>
                <a href="/for-contractors" aria-current={current("/for-contractors")}>
                  <span class="nav-link-title">For contractors</span>
                  <span class="nav-link-sub">How this works for your business</span>
                </a>
              </div>
            </details>
          </nav>
        </details>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Free Spokane-area contractor directory—no sign-in required. Verify
          licensing and insurance before hiring.{" "}
          <a href="/how-it-works">How it works</a>
          {" · "}
          <a href="/why">Why this exists</a>
          {" · "}
          <a href="/hiring-help">Hiring help</a>
          {" · "}
          <a href="/get-listed">Get listed</a>
          {" · "}
          <a href="/for-contractors">For contractors</a>
          {" · "}
          <a href="/terms">Terms & privacy</a>
        </p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        const drawer = document.querySelector("details.nav-drawer");
        const nav = document.querySelector(".site-nav");
        if (!nav) return;
        const menus = () => nav.querySelectorAll("details.nav-menu");

        const desktopNav = window.matchMedia("(min-width: 40rem)");

        function isDesktopNav() {
          return desktopNav.matches;
        }

        function syncDrawer() {
          if (!drawer) return;
          if (isDesktopNav()) drawer.setAttribute("open", "");
          else drawer.removeAttribute("open");
        }

        function closeMenus(except) {
          menus().forEach((el) => {
            if (el !== except) el.removeAttribute("open");
          });
        }

        function closeDrawer() {
          if (isDesktopNav()) return;
          drawer?.removeAttribute("open");
        }

        syncDrawer();
        desktopNav.addEventListener("change", syncDrawer);

        nav.addEventListener("toggle", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLDetailsElement) || !target.open) return;
          if (target.classList.contains("nav-menu")) closeMenus(target);
        });

        document.addEventListener("pointerdown", (event) => {
          if (
            event.target instanceof Node &&
            ((drawer && drawer.contains(event.target)) || nav.contains(event.target))
          ) {
            return;
          }
          closeMenus();
          closeDrawer();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          const openMenu = nav.querySelector("details.nav-menu[open]");
          const drawerWasOpen = Boolean(drawer?.open);
          closeMenus();
          closeDrawer();
          const focusEl =
            openMenu?.querySelector("summary") ??
            (drawerWasOpen ? drawer?.querySelector(".nav-hamburger") : null);
          if (focusEl instanceof HTMLElement) focusEl.focus();
        });
      })();
    </script>
  </body>
</html>

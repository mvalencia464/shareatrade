---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="brand-block">
          <a class="brand" href="/">Spokane Contractors</a>
          <p class="brand-tag">Free to use · No sign-in</p>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Directory</a>
          <a href="/?view=saved">Saved</a>
          <a href="/how-it-works">How it works</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Free Spokane-area contractor directory—no sign-in required. Verify
          licensing and insurance before hiring. <a href="/how-it-works">How it works</a>
        </p>
      </footer>
    </div>
  </body>
</html>
